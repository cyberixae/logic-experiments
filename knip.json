{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/web/challenge-worker.ts", "src/npc/npc-worker.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts"],
  "ignoreExportsUsedInFile": true,
